{
  "name": "@verdant/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vectors/schedule.json": "./src/models/vectors/schedule.json"
  },
  "files": ["dist", "src/models/vectors"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vectors:generate": "node scripts/generate-schedule-vectors.ts"
  },
  "dependencies": {
    "@verdant/config": "workspace:*",
    "viem": "^2.40.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
