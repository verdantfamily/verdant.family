{
  "name": "@verdant/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vectors/schedule.json": "./src/models/vectors/schedule.json",
    "./vectors/pool.json": "./src/models/vectors/pool.json",
    "./vectors/allocation.json": "./src/agents/vectors/allocation.json"
  },
  "files": ["dist", "src/models/vectors", "src/agents/vectors"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vectors:generate": "node scripts/generate-schedule-vectors.ts",
    "vectors:generate:pool": "node scripts/generate-pool-vectors.ts",
    "vectors:generate:swap": "pnpm build && node scripts/generate-swap-vectors.ts",
    "vectors:generate:allocation": "node scripts/generate-allocation-vectors.ts",
    "vectors:generate:identity": "node scripts/generate-agent-identity-vectors.ts",
    "vectors:generate:lifecycle": "node scripts/generate-lifecycle-vectors.ts",
    "abis:emit": "node scripts/emit-abis.ts"
  },
  "dependencies": {
    "@verdant/config": "workspace:*",
    "viem": "^2.40.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
