{
  "name": "@verdant/market-compiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "measure:precompile": "node scripts/precompile-recall.mjs",
    "journey:emit": "tsc -p tsconfig.json && node --experimental-strip-types scripts/emit-journey.ts",
    "approval:emit": "tsc -p tsconfig.json && node --experimental-strip-types scripts/emit-approval-vectors.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@verdant/config": "workspace:*",
    "@verdant/market-engine": "workspace:*",
    "undici": "^7.16.0",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
