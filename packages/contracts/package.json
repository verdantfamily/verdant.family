{
  "name": "@verdant/contracts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "forge build",
    "test": "bash ../../scripts/check-test-discovery.sh && forge test",
    "typecheck": "echo \"solidity: covered by forge build\" && exit 0",
    "lint": "forge fmt --check && bash ../../scripts/check-lint.sh",
    "fmt": "forge fmt",
    "snapshot": "forge snapshot --match-contract \"GasTest\"",
    "snapshot:check": "forge snapshot --check --match-contract \"GasTest\"",
    "coverage": "forge coverage --no-match-coverage \"(vendor|test|script)\" --no-match-contract \"GasTest\""
  }
}
