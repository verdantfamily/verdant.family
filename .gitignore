node_modules/
dist/
.next/
out/
.turbo/
*.tsbuildinfo

# Vercel's link to a project, and the build it uploads. Both are produced by the
# CLI and neither is source.
.vercel/

# Generated markets. Each build gets a directory under here holding model output,
# compiler artefacts and diagnostics: reproducible from the specification, large, and
# frequently thousands of files after a day of testing. A market that reaches
# deployment is recorded by its manifest and its verified source, not by this scratch.
generated/

# Foundry
packages/contracts/out/
packages/contracts/cache/
# Two levels, not one: forge writes `broadcast/<Script>.s.sol/<chainId>/dry-run/`, and a
# pattern a directory short of that matches nothing and silently commits the simulations.
packages/contracts/broadcast/*/*/dry-run/
# Every broadcast forge has ever made, one file per run. A local rig re-run twenty
# times leaves twenty of these, none of which describes the deployment anybody cares
# about. `run-latest.json` is committed and is the record; these are the noise around
# it, and they arrive in their dozens if nothing says otherwise.
packages/contracts/broadcast/*/*/run-[0-9]*.json
# Vendored by scripts/vendor-contracts-deps.sh at pinned commits; never edited
# by hand and never committed (39 MB). Run `pnpm contracts:deps` after a clone.
packages/contracts/vendor/
packages/contracts/foundry.lock

# Brand originals: camera-resolution photographs and full-canvas logo exports, tens of
# megabytes each and never served. `pnpm --filter @verdant/landing brand` turns them into
# the files in apps/landing/public/brand/, which are committed.
apps/landing/brand-source/

# env
.env
.env.*
!.env.example

# Ponder's local store and generated env types: a PGlite database and a declaration
# file, both rebuilt from ponder.config.ts on every dev run. Twice over, because Instant
# is indexed by a second Ponder app against a second database — see ADR-014.
apps/indexer/.ponder/
apps/indexer/ponder-env.d.ts
apps/instant-indexer/.ponder/
apps/instant-indexer/ponder-env.d.ts

# Further Next build directories, so a preview build, a dev server pointed at mainnet and
# an ordinary dev server can run at once without fighting over .next/. See NEXT_DIST_DIR in
# apps/web/next.config.ts. Wildcarded rather than listed, because the next one of these
# invented at a terminal would otherwise arrive as 300 MB of untracked build output.
apps/web/.next-*/

# Token images uploaded to the development store, which exists so the upload control works
# in a clone with nothing configured. The launch path refuses these addresses, so nothing
# here has ever reached a token.
apps/web/.uploads/

# The rig's logs and the notes taken while reading other people's contracts. Neither is
# source and the first is rewritten on every run.
.proof/
.instant-proof/
.research/

# os
.DS_Store

# A local shim that swallows `os.networkInterfaces()` failing, which some sandboxed
# environments make Next's dev server do on startup. Loaded with NODE_OPTIONS when it is
# needed and irrelevant everywhere else, so it is not source.
dev-os-shim.cjs

# Railway's config-as-code scratch directory, written by `railway config pull`.
.railway-config-pull-*/

# local probe output
scripts/*.local.json
